diff --git a/src/compact.rs b/src/compact.rs
--- a/src/compact.rs
+++ b/src/compact.rs
@@ -112,6 +112,12 @@ impl<T> Vec<T> {
     /// Removes and returns the element at position `index` within the vector,
     /// shifting all elements after it to the left.
     pub fn remove(&mut self, index: usize) -> T {
+        // Validate before `with` temporarily reconstructs an owning StdVec.
+        // A panic from StdVec::remove after reconstruction would unwind while
+        // both owners still describe the same allocation.
+        if index >= self.len() {
+            panic!("removal index (is {}) should be < len (is {})", index, self.len());
+        }
         self.with(move |v| v.remove(index))
     }
 
