{
  "benchmark_owned_json": false,
  "benchmarks": [
    "RPython"
  ],
  "categories": [
    "macro_single_thread"
  ],
  "claim_grade": false,
  "command_template": [
    "./replace-with-real-benchmark-command",
    "--dataset",
    "{dataset}",
    "--benchmark",
    "{benchmark}",
    "--allocator",
    "{allocator}",
    "--variant-feature",
    "{variant_feature}",
    "--run-index",
    "{run_index}",
    "--json"
  ],
  "configured": false,
  "cwd": "{real_workload_dir}",
  "datasets": [
    "default_performance",
    "type_isolation",
    "metadata_segregation",
    "hugepage_metadata",
    "pac_authentication",
    "memory_overhead",
    "web_performance",
    "windows_performance",
    "macos_performance"
  ],
  "env": {
    "UNIALLOC_PAPER_ALLOCATOR": "{allocator}",
    "UNIALLOC_PAPER_BENCHMARK": "{benchmark}",
    "UNIALLOC_PAPER_DATASET": "{dataset}",
    "UNIALLOC_PAPER_RUN_INDEX": "{run_index}",
    "UNIALLOC_PAPER_VARIANT_FEATURE": "{variant_feature}"
  },
  "measurement_source": "",
  "notes": [
    "This template is not evidence and intentionally sets configured=false.",
    "Set configured=true only after real_workload_dir points at a real checkout and command_template runs the paper macro benchmark for the requested cell.",
    "The command/env/cwd template must preserve dataset, benchmark, allocator, variant_feature, and run_index placeholders; the template env exports these as UNIALLOC_PAPER_* values for wrapper harnesses.",
    "Set benchmark_owned_json=true only after the real benchmark harness itself prints finite JSON timing for the selected cell."
  ],
  "paper_source": {
    "matchers": [
      "rustpython/rustpython",
      "github.com/rustpython/rustpython"
    ],
    "paper_benchmark": "RPython",
    "paper_project": "RustPython",
    "paper_version": "v0.1.2",
    "ref_candidates": [
      {
        "kind": "exact",
        "ref": "refs/tags/v0.1.2"
      },
      {
        "kind": "exact",
        "ref": "refs/tags/0.1.2"
      },
      {
        "kind": "fallback",
        "reason": "RustPython upstream currently exposes 0.1.0 and v0.2.0 tags but no 0.1.2 tag",
        "ref": "refs/tags/0.1.0"
      }
    ],
    "upstream_url": "https://github.com/RustPython/RustPython"
  },
  "real_workload_dir": "",
  "schema_version": 1,
  "source": "paper-external-workload-adapter-template",
  "time_fields": [
    "seconds"
  ],
  "workload_id": "external-RPython"
}
